---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import ShareButton from '../components/ShareButton';
import '../styles/global.css';

const SITE_URL = 'https://cofreutil.com.br';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  keywords: string[];
  author?: string;
}

const { title, description, publishDate, category, keywords, author } = Astro.props;

const postAuthor = author || 'Willian Scariott';

const post = {
  title,
  description,
  publishDate,
  category,
  keywords: (keywords ?? []).join(', '),
};

const canonicalPath = (() => {
  const path = Astro.url.pathname;
  if (path === '' || path === '/') return '/';
  return path.endsWith('/') ? path.slice(0, -1) : path;
})();

const canonical = new URL(canonicalPath, SITE_URL).href;

const isoDate = post.publishDate.toISOString();
const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  timeZone: 'UTC',
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(post.publishDate);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: isoDate,
  dateModified: isoDate,
  articleSection: post.category,
  keywords: post.keywords,
  inLanguage: 'pt-BR',
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Person',
    name: postAuthor,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Organization',
    name: 'CofreUtil',
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/og-image.png`,
    },
  },
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <BaseHead
      title={post.title}
      description={post.description}
      keywords={post.keywords}
      type="article"
      jsonLd={jsonLd}
    />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta property="article:published_time" content={isoDate} />
    <meta property="article:modified_time" content={isoDate} />
    <meta property="article:section" content={post.category} />
    <meta property="article:author" content={canonical} />
  </head>
  <body class="min-h-screen bg-black text-white">
    <Header />
    <main class="pt-14">
      <article class="article-body mx-auto max-w-3xl px-6 py-16 md:py-20">
        <header class="mb-12 border-b border-[#27272A] pb-8">
          <a
            href="/blog"
            class="mb-8 inline-block font-mono text-xs text-[#52525B] transition-colors hover:text-white"
          >
            // BLOG — TODOS OS ARTIGOS
          </a>
          <div class="mb-6 flex flex-wrap items-center gap-3 font-mono text-xs">
            <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 text-[#A1A1AA]">
              [ CATEGORIA: {post.category} ]
            </span>
            <span class="text-[#52525B]">{formattedDate}</span>
          </div>
          <h1 class="text-3xl font-bold leading-tight tracking-tight md:text-4xl">
            {post.title}
          </h1>
          <p class="mt-4 font-mono text-sm text-[#A1A1AA]">
            Escrito por <span class="font-bold text-white">{postAuthor}</span>
            <span class="mx-2 text-[#52525B]">•</span>
            {formattedDate}
          </p>
          <p class="mt-4 text-base leading-relaxed text-[#A1A1AA]">{post.description}</p>
        </header>

        <slot />

        <footer class="mt-16 border-t border-[#27272A] pt-8">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <a
              href="/blog"
              class="inline-block font-mono text-sm text-white transition-colors hover:text-[#A1A1AA]"
            >
              ← VOLTAR PARA TODOS OS ARTIGOS
            </a>
            <ShareButton client:only="react" />
          </div>
        </footer>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .article-body {
    font-family: 'Geist Sans', 'Inter', system-ui, sans-serif;
    color: #d4d4d8;
    line-height: 1.75;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .article-body h1,
  .article-body h2,
  .article-body h3,
  .article-body h4,
  .article-body h5,
  .article-body h6 {
    color: #ffffff;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .article-body h2 {
    font-size: 1.5rem;
  }

  .article-body h3 {
    font-size: 1.25rem;
  }

  .article-body h4 {
    font-size: 1.125rem;
  }

  .article-body p {
    margin-bottom: 1.5rem;
  }

  .article-body a:not(.bg-white) {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: #3f3f46;
    transition: color 0.2s ease;
  }

  .article-body a:not(.bg-white):hover {
    color: #a1a1aa;
  }

  .article-body ul,
  .article-body ol {
    margin: 0 0 1.5rem 0;
    padding-left: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  .article-body ul {
    list-style: square;
  }

  .article-body ol {
    list-style: decimal;
  }

  .article-body li::marker {
    color: #52525b;
  }

  .article-body strong {
    color: #ffffff;
  }

  .article-body blockquote {
    border-left: 4px solid #27272a;
    padding: 1rem 1.25rem;
    margin: 0 0 1.5rem 0;
    background-color: #09090b;
    color: #a1a1aa;
  }

  .article-body blockquote p:last-child {
    margin-bottom: 0;
  }

  .article-body code {
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.875em;
    background-color: #09090b;
    border: 1px solid #27272a;
    padding: 0.125rem 0.375rem;
    color: #ffffff;
  }

  .article-body hr {
    border: 0;
    border-top: 1px solid #27272a;
    margin: 2.5rem 0;
  }

  .article-body img {
    border: 1px solid #27272a;
    margin: 1.5rem 0;
  }

  .article-body div {
    border-radius: 0 !important;
  }
</style>