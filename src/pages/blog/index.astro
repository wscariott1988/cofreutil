---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const tabs = [
  { label: 'Todos', value: 'todos' },
  { label: 'PDF', value: 'PDF' },
  { label: 'Mídia', value: 'Mídia' },
  { label: 'Dados & Dev', value: 'Dados & Dev' },
  { label: 'Segurança', value: 'Segurança' },
  { label: 'B2B / APIs', value: 'B2B / APIs' },
];

const title = 'Blog | CofreUtil — Como Fazer Grátis, Sem Login e 100% Privado';
const description =
  'Guias rápidos sobre como juntar PDF, comprimir arquivos, gerar link de WhatsApp, extrair texto de imagem e muito mais — tudo gratuito, sem cadastro e com processamento 100% local.';

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', { timeZone: 'UTC', day: '2-digit', month: 'short', year: 'numeric' }).format(date);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog CofreUtil',
  description,
  url: 'https://cofreutil.com.br/blog',
  publisher: { '@type': 'Organization', name: 'CofreUtil', url: 'https://cofreutil.com.br' },
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section id="blog-feed" class="mx-auto max-w-6xl px-6 pb-24 pt-28 md:pt-32">
    <header class="border-b border-[#27272A] pb-10">
      <span class="font-mono text-xs text-[#52525B]">// BASE DE CONHECIMENTO</span>
      <h1 class="mt-4 font-mono text-3xl font-bold leading-tight tracking-tight md:text-5xl">
        Blog do <span class="text-[#A1A1AA]">CofreUtil</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-[#A1A1AA] md:text-lg">
        {description}
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="mt-16 font-mono text-sm text-[#52525B]">// NENHUM ARTIGO PUBLICADO AINDA</p>
    ) : (
      <>
        <nav
          aria-label="Filtrar artigos por categoria"
          class="sticky top-14 z-20 mt-10 border border-[#27272A] bg-[#09090B] px-3 py-3"
        >
          <div class="flex items-center gap-2 overflow-x-auto">
            <span class="hidden shrink-0 pr-1 font-mono text-[10px] tracking-widest text-[#52525B] sm:inline">
              // FILTRO
            </span>
            {tabs.map((tab) => (
              <button
                type="button"
                class="blog-tab shrink-0 px-4 py-2 font-mono text-xs tracking-wide transition-colors"
                data-blog-tab={tab.value}
                aria-pressed={tab.value === 'todos'}
              >
                {tab.label}
              </button>
            ))}
            <span class="ml-auto hidden shrink-0 pl-2 font-mono text-[10px] tracking-widest text-[#52525B] md:inline">
              {posts.length} ARTIGOS
            </span>
          </div>
        </nav>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="blog-card group flex flex-col gap-3 border border-[#27272A] bg-[#09090B] p-6 transition-colors hover:border-[#3F3F46] hover:bg-[#18181B]"
              data-blog-category={post.data.category}
            >
              <div class="flex items-center justify-between gap-4">
                <span class="self-start border border-[#27272A] bg-black px-2 py-0.5 font-mono text-xs text-[#A1A1AA]">
                  {post.data.category}
                </span>
                <span class="font-mono text-xs text-[#52525B]">{formatDate(post.data.publishDate)}</span>
              </div>
              <h2 class="font-mono text-sm font-medium leading-snug text-white">{post.data.title}</h2>
              <p class="text-xs leading-relaxed text-[#A1A1AA]">{post.data.description}</p>
              <span class="mt-auto font-mono text-xs text-[#52525B] group-hover:text-[#A1A1AA]">
                /blog/{post.id} →
              </span>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</Layout>

<style>
  .blog-tab {
    border: 1px solid #27272a;
    border-radius: 0;
    background: #000000;
    color: #ffffff;
  }

  .blog-tab:hover {
    background: #18181b;
  }

  .blog-tab.is-active {
    background: #ffffff;
    color: #000000;
  }

  .blog-card {
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .blog-card.is-hidden {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
  }

  .blog-card.is-reveal {
    animation: blogCardIn 0.22s ease both;
  }

  @keyframes blogCardIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const tabs = Array.from(document.querySelectorAll('[data-blog-tab]'));
    const cards = Array.from(document.querySelectorAll('[data-blog-category]'));
    if (tabs.length === 0 || cards.length === 0) return;

    const setActiveTab = (value: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.blogTab === value;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-pressed', String(active));
      });
    };

    const applyFilter = (value: string) => {
      cards.forEach((card) => {
        const match = value === 'todos' || card.dataset.blogCategory === value;
        if (match) {
          card.hidden = false;
          card.classList.remove('is-hidden');
          card.classList.add('is-reveal');
        } else {
          card.classList.remove('is-reveal');
          card.classList.add('is-hidden');
          window.setTimeout(() => {
            if (card.classList.contains('is-hidden')) card.hidden = true;
          }, 200);
        }
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const value = tab.dataset.blogTab ?? 'todos';
        applyFilter(value);
        setActiveTab(value);
      });
    });

    setActiveTab('todos');
  })();
</script>