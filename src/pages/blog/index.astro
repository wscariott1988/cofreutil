---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_URL, ORG_ID, SITE_NAME } from '../../lib/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const tabs = [
  { label: 'Todos', value: 'todos' },
  { label: 'PDF', value: 'PDF' },
  { label: 'Mídia', value: 'Mídia' },
  { label: 'Dados & Dev', value: 'Dados & Dev' },
  { label: 'Segurança', value: 'Segurança' },
  { label: 'B2B / APIs', value: 'B2B / APIs' },
];

const title = 'Blog | CofreUtil — Guias Técnicos e Tutoriais Gratuitos';
const description =
  'Guias rápidos sobre como juntar PDF, comprimir arquivos, gerar link de WhatsApp, extrair texto de imagem e muito mais — gratuito, sem cadastro e com processamento local no navegador.';

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', {
    timeZone: 'UTC',
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  })
    .format(date)
    .replace(/ de /g, ' ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE_URL}/blog`,
  name: 'Blog CofreUtil',
  description,
  url: `${SITE_URL}/blog`,
  inLanguage: 'pt-BR',
  isPartOf: { '@id': `${SITE_URL}#website` },
  publisher: { '@id': ORG_ID },
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section id="blog-feed" class="mx-auto max-w-6xl px-6 pb-24 pt-28 md:pt-32">
    <header class="border-b border-[#27272A] pb-10">
      <span class="font-mono text-xs text-[#52525B]">// BASE DE CONHECIMENTO</span>
      <h1 class="mt-4 font-mono text-3xl font-bold leading-tight tracking-tight md:text-5xl">
        Blog do <span class="text-[#A1A1AA]">CofreUtil</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-[#A1A1AA] md:text-lg">
        {description}
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="mt-16 font-mono text-sm text-[#52525B]">// NENHUM ARTIGO PUBLICADO AINDA</p>
    ) : (
      <>
        <nav
          aria-label="Filtrar artigos por categoria"
          class="sticky top-14 z-20 mt-10 border border-[#27272A] bg-[#09090B] px-3 py-3"
        >
          <div class="flex items-center gap-2 overflow-x-auto">
            <span class="hidden shrink-0 pr-1 font-mono text-[10px] tracking-widest text-[#52525B] sm:inline">
              // FILTRO
            </span>
            {tabs.map((tab) => (
              <button
                type="button"
                class="blog-tab shrink-0 px-4 py-2 font-mono text-xs tracking-wide transition-colors"
                data-blog-tab={tab.value}
                aria-pressed={tab.value === 'todos'}
              >
                {tab.label}
              </button>
            ))}
            <span class="ml-auto hidden shrink-0 pl-2 font-mono text-[10px] tracking-widest text-[#52525B] md:inline">
              {posts.length} ARTIGOS
            </span>
          </div>
        </nav>

        <div class="mt-8 border-t border-[#27272a]">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="blog-row group grid grid-cols-[88px_1fr_auto] items-center gap-3 border-b border-[#27272a] py-4 transition-opacity sm:gap-6 md:grid-cols-[120px_1fr_auto]"
              data-blog-category={post.data.category}
            >
              <time class="font-mono text-xs text-[#52525b]">
                {formatDate(post.data.publishDate)}
              </time>
              <h2 class="truncate font-mono text-sm font-bold text-white underline-offset-4 transition-colors group-hover:underline md:text-base">
                {post.data.title}
              </h2>
              <span class="justify-self-end rounded-none border border-[#27272a] px-2 py-0.5 font-mono text-[10px] text-[#a1a1aa]">
                {post.data.category}
              </span>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</Layout>

<style>
  .blog-tab {
    border: 1px solid #27272a;
    border-radius: 0;
    background: #000000;
    color: #ffffff;
  }

  .blog-tab:hover {
    background: #18181b;
  }

  .blog-tab.is-active {
    background: #ffffff;
    color: #000000;
  }

  .blog-row {
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .blog-row.is-reveal {
    animation: blogRowIn 0.22s ease both;
  }

  @keyframes blogRowIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const tabs = Array.from(document.querySelectorAll('[data-blog-tab]'));
    const rows = Array.from(document.querySelectorAll('[data-blog-category]'));
    if (tabs.length === 0 || rows.length === 0) return;

const normalizeCategory = (value: string) =>
      (value ?? '')
        .toLowerCase()
        .trim()
        .replace(/\s+/g, ' ')
        .replace(/^b2b$/i, 'b2b / apis')
        .replace(/^b2b\s*\/\s*apis$/, 'b2b / apis');

    const setActiveTab = (value: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.blogTab === value;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-pressed', String(active));
      });
    };

    const applyFilter = (value: string) => {
      const normalized = normalizeCategory(value);
      rows.forEach((row) => {
        const rowCategory = normalizeCategory(row.dataset.blogCategory ?? '');
        const match = normalized === 'todos' || rowCategory === normalized;
        if (match) {
          row.classList.remove('hidden');
          row.hidden = false;
          row.classList.add('is-reveal');
        } else {
          row.hidden = true;
          row.classList.add('hidden');
          row.classList.remove('is-reveal');
        }
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const value = tab.dataset.blogTab ?? 'todos';
        applyFilter(value);
        setActiveTab(value);
      });
    });

    setActiveTab('todos');
  })();
</script>