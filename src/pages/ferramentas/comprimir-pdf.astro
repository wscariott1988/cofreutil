---
import Layout from '../../layouts/Layout.astro';
import PdfCompressTool from '../../components/tools/PdfCompressTool';
---

<Layout
  title="Comprimir PDF Seguro | Diminuir Tamanho do Arquivo Offline | CofreUtil"
  description="Reduza o tamanho de PDFs pesados sem risco de vazamento de dados. Comprima 100% no navegador, sem enviar arquivos para servidores, com privacidade total."
>
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-28 md:pt-36">
    <div class="mb-10 flex flex-col gap-6">
      <div class="flex items-center gap-3">
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [Zero-Server]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [LGPD]
        </span>
      </div>

      <h1 class="font-mono text-3xl font-bold leading-tight tracking-tight md:text-4xl">
        Comprimir PDF (Diminuir Tamanho)
      </h1>

      <h2 class="max-w-2xl text-lg leading-relaxed text-[#A1A1AA]">
        A forma mais segura de diminuir o tamanho de um PDF (LGPD).
      </h2>

      <p class="max-w-2xl text-sm leading-relaxed text-[#A1A1AA]">
        Reduza o tamanho de PDFs pesados sem risco de vazamento de dados. Ideal para
        advogados, contadores e empresas que lidam com informações confidenciais. O
        processo roda 100% no seu navegador, zero upload e zero armazenamento em nuvem.
      </p>
    </div>

    <PdfCompressTool client:only="react" />

    <!-- CONTEÚDO PERSUASIVO & H2 DE CAUDA LONGA -->
    <div class="mt-16 flex flex-col gap-10">
      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Como comprimir um PDF sem enviar o arquivo para servidores?
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          O nosso compressor processa o documento diretamente na memória do navegador
          usando a biblioteca pdf-lib em WebAssembly. Metadados órfãos e objetos
          duplicados são descartados e os streams são reescritos compactados, reduzindo
          o tamanho do PDF sem qualquer upload para serviços externos.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Reduza PDFs confidenciais com segurança para advogados e contadores
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          Contratos, petições e declarações muitas vezes ultrapassam o limite de e-mail.
          Comprimir localmente evita que documentos com dados sensíveis transitem por
          servidores de terceiros, reduzindo riscos de vazamento e alinhando-se aos
          princípios da LGPD de minimização e segurança de dados.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Processamento local, privacidade de ponta a ponta
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          Como toda a otimização acontece no seu navegador, nenhuma cópia do arquivo é
          armazenada ou indexada. Resultado: redução de tamanho com privacidade total e
          zero custo de infraestrutura.
        </p>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16">
      <h2 class="mb-6 font-mono text-xl font-bold text-white">
        Perguntas Frequentes sobre Comprimir PDF
      </h2>
      <div class="flex flex-col border border-[#27272A] bg-[#09090B]">
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Esta ferramenta funciona offline?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Sim. Após o carregamento inicial da página, a compressão acontece 100% no
            seu navegador, sem necessidade de conexão com a internet.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Quanto posso reduzir o tamanho do meu PDF?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Depende do conteúdo e do nível escolhido (Leve, Moderada ou Alta). O painel
            de resultado mostra o novo tamanho e o percentual economizado. Documentos
            com imagem pesada costumam ter reduções significativas.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Meu PDF é enviado para algum servidor?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Não. O arquivo é comprimido inteiramente na sua máquina, sem upload ou
            armazenamento em servidores. Seus documentos nunca saem do seu computador.
          </p>
        </details>
      </div>
    </div>

    <!-- SCHEMA.ORG -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'SoftwareApplication',
            name: 'Comprimir PDF — CofreUtil',
            applicationCategory: 'UtilitiesApplication',
            operatingSystem: 'Web Browser',
            description: 'Reduza o tamanho de PDFs pesados sem risco de vazamento de dados. Compressão 100% local no navegador, com privacidade total e LGPD.',
            url: 'https://cofreutil.com.br/ferramentas/comprimir-pdf',
            offers: {
              '@type': 'Offer',
              price: '0',
              priceCurrency: 'BRL',
            },
            author: {
              '@type': 'Person',
              name: 'Willian Scariott',
            },
          },
          {
            '@type': 'FAQPage',
            mainEntity: [
              {
                '@type': 'Question',
                name: 'Esta ferramenta funciona offline?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Sim. Após o carregamento inicial da página, a compressão acontece 100% no seu navegador, sem necessidade de conexão com a internet.',
                },
              },
              {
                '@type': 'Question',
                name: 'Quanto posso reduzir o tamanho do meu PDF?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Depende do conteúdo e do nível escolhido. O painel de resultado mostra o novo tamanho e o percentual economizado.',
                },
              },
              {
                '@type': 'Question',
                name: 'Meu PDF é enviado para algum servidor?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Não. O arquivo é comprimido inteiramente na sua máquina, sem upload ou armazenamento em servidores.',
                },
              },
            ],
          },
        ],
      })}
    />
  </section>
</Layout>
