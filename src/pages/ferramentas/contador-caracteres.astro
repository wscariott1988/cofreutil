---
import Layout from '../../layouts/Layout.astro';
import CharCounterTool from '../../components/tools/CharCounterTool';
import { toolPageGraph, SITE_URL } from '../../lib/site';
import TechnicalReferences from '../../components/TechnicalReferences.astro';

const jsonLd = toolPageGraph({
  name: 'Contador de Caracteres e Palavras — CofreUtil',
  description: 'Contador de caracteres e palavras offline com analise de densidade de SEO: estatisticas completas e tempo de leitura — privado, sem envio de dados.',
  url: `${SITE_URL}/ferramentas/contador-caracteres`,
  type: 'WebApplication',
  applicationCategory: 'UtilitiesApplication',
  breadcrumb: [
    { name: 'Home', url: SITE_URL },
    { name: 'Ferramentas', url: `${SITE_URL}/ferramentas` },
    { name: 'Contador de Caracteres e Palavras Offline Seguro', url: `${SITE_URL}/ferramentas/contador-caracteres` },
  ],
  faq: [
    { name: 'Meu texto e enviado para algum servidor ao contar caracteres?', text: 'Nao. Todo o processamento acontece no seu navegador, na memoria RAM. Nenhum caractere sai da sua maquina — sem envio a servidores.' },
    { name: 'O que e densidade de palavras e por que importa para SEO?', text: 'Densidade de palavras e a porcentagem de vezes que uma palavra aparece em relacao ao total. Palavras acima de 2-3% podem indicar keyword stuffing, penalizado por motores de busca.' },
    { name: 'Como e calculado o tempo estimado de leitura?', text: 'O tempo de leitura e baseado na media de 200 palavras por minuto, velocidade media para textos em portugues.' },
    { name: 'Preciso pagar ou me cadastrar para usar o contador?', text: 'Nao. A ferramenta e gratuita e sem cadastro.' },
    { name: 'Posso usar offline apos o primeiro carregamento?', text: 'Sim. Apos o carregamento da pagina, todo o processamento e local e funciona sem conexao com a internet.' },
  ],
});
---

<Layout
  title="Contador de Caracteres e Palavras Offline Seguro | CofreUtil"
  description="Contador de caracteres e palavras offline: analise texto com densidade de SEO, tempo de leitura e estatisticas completas — privado e sem sair do navegador."
  keywords="contar letras de texto online, contador de caracteres redacao, ferramenta para contar palavras, contador de caracteres offline, analise densidade seo, contar palavras online gratis"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-28 md:pt-36">
    <div class="mb-10 flex flex-col gap-6">
      <div class="flex items-center gap-3">
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [Zero-Server]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [DADOS & DEV]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [LGPD]
        </span>
      </div>

      <h1 class="font-mono text-3xl font-bold leading-tight tracking-tight md:text-4xl">
        Contador de Caracteres e Palavras Offline Seguro
      </h1>

      <h2 class="max-w-2xl text-lg leading-relaxed text-[#A1A1AA]">
        Ferramenta para contar palavras e caracteres com analise de densidade de SEO:
        veja estatisticas completas do seu texto em tempo real, offline e privado.
      </h2>

      <p class="max-w-2xl text-sm leading-relaxed text-[#A1A1AA]">
        Cole ou digite qualquer texto para obter instantaneamente o numero de caracteres
        (com e sem espacos), palavras, linhas, paragrafos e tempo estimado de leitura.
        A analise de densidade de palavras identifica termos com alta repeticao — ideal para
        redatores que desejam evitar keyword stuffing em textos para SEO.
        <span class="hidden text-[#52525B]"> contar letras de texto online contador de caracteres redacao ferramenta para contar palavras </span>
      </p>
    </div>

    <CharCounterTool client:only="react" />

    <!-- CONTEUDO PERSUASIVO & H2 DE CAUDA LONGA -->
    <div class="mt-16 flex flex-col gap-10">
      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Por que usar um contador de caracteres offline para redacao?
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          Redacoes academicas, artigos para blogs e postagens em redes sociais possuem
          limites rigidos de caracteres e palavras. Colar seu texto em um servico online
          pode expor dados sensiveis. O CofreUtil resolve isso rodando no navegador:
          o texto nunca sai da sua maquina, garantindo privacidade por arquitetura.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Analise de densidade de palavras para SEO: como funciona?
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          A ferramenta calcula a frequencia de cada palavra com 2 ou mais silabas
          (excluindo conectivos comuns como "de", "para", "com"), apresentando a
          porcentagem de aparecimento de cada termo. Palavras com mais de 2-3% de
          densidade podem indicar keyword stuffing — pratica penalizada por motores
          de busca como Google. Use a tabela de densidade para refinar seus textos
          e melhorar o ranqueamento organico.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          E seguro contar palavras e caracteres aqui sem enviar meus textos?
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          Sim. Este contador e offline (arquitetura Zero-Server): o texto
          digitado permanece na sua maquina, todo o processamento acontece localmente
          na memoria RAM e nenhum dado e registrado ou transmitido. Voce pode contar
          caracteres e analisar densidade de SEO de textos sensiveis — como contratos,
          redacoes e artigos — com total privacidade e seguranca.
        </p>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16">
      <h2 class="mb-6 font-mono text-xl font-bold text-white">
        Perguntas Frequentes sobre Contar Palavras e Caracteres Online
      </h2>
      <div class="flex flex-col border border-[#27272A] bg-[#09090B]">
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Meu texto e enviado para algum servidor ao contar caracteres?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Nao. Todo o processamento acontece no seu navegador, na memoria RAM.
            Nenhum caractere sai da sua maquina — sem envio do conteudo a servidores.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            O que e densidade de palavras e por que importa para SEO?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Densidade de palavras e a porcentagem de vezes que uma palavra aparece
            em relacao ao total de palavras do texto. Palavras repetidas acima de 2-3%
            podem indicar keyword stuffing, pratica penalizada por motores de busca.
            A tabela de densidade ajuda a identificar e corrigir essas repeticoes.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Como e calculado o tempo estimado de leitura?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            O tempo de leitura e baseado na media de 200 palavras por minuto, velocidade
            media de leitura para textos em portugues. A ferramenta divide o total de
            palavras por 200 e arredonda para cima.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Preciso pagar ou me cadastrar para usar o contador?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Nao. A ferramenta e gratuita e sem cadastro. Apos varias utilizacoes,
            uma mensagem amigavel sugere um apoio voluntario via Pix para manter o
            CofreUtil no ar.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Posso usar offline apos o primeiro carregamento?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Sim. Apos o carregamento da pagina, todo o processamento e local e o
            contador continua funcionando sem conexao com a internet — ideal para
            uso em ambientes sem Wi-Fi.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <TechnicalReferences slug="contador-caracteres" />
  </section>
</Layout>
