---
import Layout from '../../layouts/Layout.astro';
import AudioConverterTool from '../../components/tools/AudioConverterTool';
import ShareButton from '../../components/ShareButton';
import TechnicalReferences from '../../components/TechnicalReferences.astro';
import { toolPageGraph, SITE_URL } from '../../lib/site';

const toolUrl = `${SITE_URL}/ferramentas/conversor-de-audio`;

const jsonLd = toolPageGraph({
  type: 'WebApplication',
  name: 'Conversor de Áudio Online — WAV para MP3 e OGG com Corte | CofreUtil',
  url: toolUrl,
  applicationCategory: 'MultimediaApplication',
  browserRequirements: 'Requires JavaScript',
  featureList: [
    'Converter WAV, MP3 e OGG no navegador',
    'Conversão sem enviar o arquivo a servidores',
    'Cortar trechos de áudio e baixar só o trecho',
    'Exportar em WAV (sem perdas), MP3 (até 320kbps) ou OGG Vorbis',
    'Ouvir o trecho selecionado antes de converter',
    'Aceita WAV, MP3, OGG, M4A e WebM',
  ],
  description:
    'Converta e corte áudio online grátis: WAV, MP3 e OGG no navegador, sem upload e sem login. Privacidade por arquitetura: seu arquivo nunca sai da sua máquina.',
  breadcrumb: [
    { name: 'Home', url: SITE_URL },
    { name: 'Ferramentas', url: `${SITE_URL}/ferramentas` },
    {
      name: 'Conversor de Áudio Online e Cortador de Trechos',
      url: toolUrl,
    },
  ],
  faq: [
    {
      name: 'Como converter WAV para MP3 grátis sem enviar o arquivo?',
      text: 'Selecione o arquivo WAV e escolha MP3 na saída. O conversor processa tudo no seu navegador com encode LAME (até 320kbps). Nenhum byte do áudio sai da sua máquina.',
    },
    {
      name: 'Qual é o limite de tamanho do arquivo de áudio?',
      text: 'Aceitamos arquivos de até 100MB. Formatos suportados na entrada: WAV, MP3, OGG, M4A e WebM.',
    },
    {
      name: 'Posso cortar um trecho e converter só ele?',
      text: 'Sim. Defina o início e o fim em segundos, ouça o trecho com o botão [Ouvir Trecho] e converta. O resultado será apenas o trecho, no formato escolhido.',
    },
    {
      name: 'O arquivo de áudio fica armazenado em algum servidor?',
      text: 'Não. A decodificação, o corte e a codificação (WAV, MP3 e OGG) acontecem na memória do seu navegador, com arquitetura zero-server.',
    },
    {
      name: 'Por que escolher o formato OGG?',
      text: 'OGG (Vorbis) é um codec aberto, sem royalties, com ótima taxa de compactação em relação à qualidade — melhor tamanho que MP3 na mesma escuta subjetiva, ideal para web e armazenamento.',
    },
  ],
});
---

<Layout
  title="Conversor de Áudio Online — WAV para MP3 e OGG | Corte de Áudio | CofreUtil"
  description="Converter áudio online grátis: WAV para MP3, MP3 para OGG, cortar trechos e baixar no navegador, sem upload e sem login. Privacidade por arquitetura."
  keywords="converter audio wav mp3, conversor de audio online gratis, cortar audio wav, converter audio para ogg, audio para mp3 sem enviar servidor, converter audio offline"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-28 md:pt-36">
    <div class="mb-10 flex flex-col gap-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [Zero-Server]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [Sem Login]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [WAV]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [MP3]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [OGG]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [Corte]
        </span>
        <span class="border border-[#27272A] bg-[#09090B] px-2 py-1 font-mono text-xs text-[#A1A1AA]">
          [LGPD]
        </span>
      </div>

      <h1 class="font-mono text-3xl font-bold leading-tight tracking-tight md:text-4xl">
        Conversor de Áudio Online e Cortador de Trechos
      </h1>

      <h2 class="max-w-2xl text-lg leading-relaxed text-[#A1A1AA]">
        Converta WAV para MP3 ou OGG e corte áudio no navegador.
      </h2>

      <p class="max-w-2xl text-sm leading-relaxed text-[#A1A1AA]">
        Arraste seu arquivo de áudio (WAV, MP3, OGG, M4A ou WebM), selecione o formato de
        saída — e, se quiser, marque o trecho exato de início e fim — e baixe o resultado.
        O processamento acontece inteiramente na sua máquina: o arquivo nunca é enviado a
        servidores, nem exige cadastro.
      </p>
    </div>

    <AudioConverterTool client:only="react" />

    <div class="mt-8 flex justify-end">
      <ShareButton client:only="react" />
    </div>

    <!-- CONTEÚDO PERSUASIVO & H2 DE CAUDA LONGA -->
    <div class="mt-16 flex flex-col gap-10">
      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Converter áudio WAV para MP3 grátis e sem conversores pesados
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          Gravações de voz, trilhas e arquivos capturados em WAV ocupam muito espaço
          porque são PCM sem compressão. Em poucos cliques o CofreUtil converte para MP3
          com o encoder LAME rodando dentro do seu navegador, com bitrate de 128, 192 ou
          320kbps — o arquivo final fica até 10x menor, pronto para enviar, publicar ou
          arquivar.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Cortar arquivos de áudio longos em formatos compactos
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          Não precisa de editor completo para extrair um trecho. Informe o início e o fim
          em segundos, confira com [Ouvir Trecho] e baixe apenas o pedaço no formato que
          escolher. Ideal para recortar aulas, entrevistas, reuniões e mensagens de voz
          sem abrir nenhum programa.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Converter áudio para OGG no navegador
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          O formato OGG (Vorbis) entrega excelente qualidade por traço de tamanho e é
          totalmente aberto. A codificação Vorbis roda localmente via WASM, sem royalties
          e sem depender de serviços externos — perfeito para produção de conteúdo leve e
          sites rápidos.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="font-mono text-xl font-bold text-white">
          Por que converter áudio localmente (sem enviar o arquivo)?
        </h2>
        <p class="max-w-3xl text-sm leading-relaxed text-[#A1A1AA]">
          Conversores online tradicionais recebem o seu arquivo, gravam uma cópia e podem
          usá-la para treinar IA, vender ou vazar. Aqui, decodificação, corte e codificação
          acontecem 100% na memória do navegador: nada sai da sua máquina, não há conta,
          não há fila de espera nem limite de banda. É a privacidade da LGPD aplicada ao
          processamento de áudio.
        </p>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16">
      <h2 class="mb-6 font-mono text-xl font-bold text-white">
        Perguntas Frequentes sobre o Conversor de Áudio
      </h2>
      <div class="flex flex-col border border-[#27272A] bg-[#09090B]">
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Como converter WAV para MP3 sem instalar nada?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Selecione ou arraste o arquivo WAV, escolha MP3 no painel de saída e clique em
            [Converter e Baixar]. Tudo roda no navegador, sem instalação e sem login.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Quais formatos o conversor aceita na entrada?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            WAV, MP3, OGG, M4A e WebM, com limite de 100MB por arquivo. O navegador decodifica
            os formatos nativamente, então tudo permanece local.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Consigo cortar um trecho antes de converter?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Sim. Use os campos Início e Fim (em segundos), toque em [Ouvir Trecho] para
            conferir e converta. O download virá apenas com o trecho selecionado.
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Meu áudio é enviado para algum servidor?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            Não. Codificação (WAV/MP3/OGG), decodificação e corte acontecem 100% na memória
            do seu navegador. Nenhum arquivo sai da sua máquina (arquitetura zero-server,
            LGPD).
          </p>
        </details>
        <details class="border-b border-[#27272A] last:border-b-0">
          <summary class="cursor-pointer px-5 py-4 font-mono text-sm text-white">
            Qual bitrate de MP3 devo escolher?
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-[#A1A1AA]">
            128kbps é leve e suficiente para voz; 192kbps equilibra tamanho e qualidade;
            320kbps é o máximo para música. Se precisar de maior fidelidade ainda, exporte
            em WAV ou OGG.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <TechnicalReferences slug="conversor-de-audio" />
  </section>
</Layout>