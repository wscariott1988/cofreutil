---
import Layout from '../../layouts/Layout.astro';

const categories = [
  {
    id: 'midia',
    label: '[MÍDIA]',
    tagline: 'Conversão, edição e leitura de imagens, áudio, PDF e mídia em geral.',
    items: [
      {
        href: '/ferramentas/conversor-de-imagem',
        title: 'Conversor de Imagens',
        desc: 'Converta JPG, PNG, WEBP, GIF e BMP em lote para PNG, JPG ou WEBP, 100% no navegador, sem upload.',
      },
      {
        href: '/ferramentas/extrair-texto-imagem',
        title: 'Extrator de Texto de Imagem (OCR)',
        desc: 'Converta imagem para texto grátis e extraia texto de print em Português ou Inglês 100% no navegador, com OCR offline e Tesseract.js local. Zero upload.',
      },
      {
        href: '/ferramentas/leitor-qr-code',
        title: 'Leitor e Scanner de QR Code',
        desc: 'Escaneie QR Codes pela câmera/webcam ou leia de imagens PNG, JPG e WEBP localmente, com cópia em um clique e aviso de link seguro.',
      },
      {
        href: '/ferramentas/leitor-mrz-passaporte',
        title: 'Leitor de MRZ / Passaportes',
        desc: 'Leia a zona MRZ (TD1, TD2 e TD3) de passaportes e identidades por foto ou câmera, com validação de dígitos de controle. OCR 100% local.',
      },
      {
        href: '/ferramentas/juntar-pdf',
        title: 'Juntar PDF',
        desc: 'Mescle PDFs 100% no navegador, sem enviar documentos a servidores.',
      },
      {
        href: '/ferramentas/dividir-pdf',
        title: 'Dividir PDF',
        desc: 'Extraia páginas específicas ou divida cada página como PDF individual, 100% local.',
      },
      {
        href: '/ferramentas/comprimir-pdf',
        title: 'Comprimir PDF',
        desc: 'Reduza o tamanho de PDFs pesados 100% no navegador, sem enviar arquivos a servidores.',
      },
      {
        href: '/ferramentas/imagem-para-pdf',
        title: 'Imagem para PDF',
        desc: 'Converta JPG, PNG e WEBP em um único PDF, 100% no navegador, sem upload.',
      },
      {
        href: '/ferramentas/pdf-para-imagem',
        title: 'PDF para Imagem',
        desc: 'Converta páginas de PDF em PNG, JPEG ou WEBP 100% no navegador, sem upload.',
      },
      {
        href: '/ferramentas/conversor-de-audio',
        title: 'Conversor de Áudio',
        desc: 'Converta WAV, MP3 e OGG e corte trechos 100% no navegador, sem upload. Zero servidores.',
      },
      {
        href: '/ferramentas/remover-silencio',
        title: 'Removedor de Silêncio',
        desc: 'Remova silêncios de vídeos e áudios 100% no navegador via FFmpeg local, com corte e concatenação lossless (-c copy). Zero upload.',
      },
    ],
  },
  {
    id: 'seguranca',
    label: '[SEGURANÇA]',
    tagline: 'Privacidade, higienização de metadados, senhas e integridade de arquivos.',
    items: [
      {
        href: '/ferramentas/limpador-de-metadados-exif',
        title: 'Limpador de Metadados EXIF',
        desc: 'Remova GPS e dados da câmera de fotos (JPG, PNG, WEBP) 100% no navegador, sem upload.',
      },
      {
        href: '/ferramentas/sanitizador-pdf',
        title: 'Sanitizador de Metadados de PDF',
        desc: 'Remova autor, software e datas ocultas de PDFs 100% no navegador, sem enviar documentos a servidores. Ideal para escritórios e LGPD.',
      },
      {
        href: '/ferramentas/gerador-senhas',
        title: 'Gerador de Senhas Fortes',
        desc: 'Gere senhas com criptografia Web Crypto (getRandomValues), medindo entropia e tempo estimado de quebra. 100% local.',
      },
      {
        href: '/ferramentas/calculadora-hash',
        title: 'Calculadora de Hash de Arquivos',
        desc: 'Calcule MD5, SHA-1, SHA-256 e SHA-512 de qualquer arquivo 100% no navegador, com leitura em chunks e crypto.subtle nativo.',
      },
      {
        href: '/ferramentas/gerador-de-cpf',
        title: 'Gerador de CPF/CNPJ',
        desc: 'Gere e valide CPFs e CNPJs com algoritmo matemático local. Sem API externa.',
      },
    ],
  },
  {
    id: 'dados-dev',
    label: '[DADOS & DEV]',
    tagline: 'Formatação, conversão, validação e automação para quem trabalha com dados.',
    items: [
      {
        href: '/ferramentas/formatador-json',
        title: 'Formatador e Validador JSON',
        desc: 'Formate, minifique e valide JSON com relatório de erros (linha/coluna). Processamento 100% local.',
      },
      {
        href: '/ferramentas/conversor-csv-json',
        title: 'Conversor CSV para JSON',
        desc: 'Converta CSV em JSON e JSON em CSV com vírgula, ponto e vírgula ou tab. Tratamento RFC 4180, 100% local.',
      },
      {
        href: '/ferramentas/comparar-textos',
        title: 'Comparar Textos',
        desc: 'Diff checker offline: veja alterações entre dois textos ou contratos em linhas, palavras ou caracteres. 100% local e privado (LGPD).',
      },
      {
        href: '/ferramentas/contador-caracteres',
        title: 'Contador de Caracteres e Palavras',
        desc: 'Contador offline com análise de densidade de SEO, tempo de leitura e estatísticas completas. 100% privado e local.',
      },
      {
        href: '/ferramentas/gerador-link-whatsapp',
        title: 'Gerador de Link para WhatsApp',
        desc: 'Crie link de WhatsApp grátis sem login, com mensagem personalizada, simulador ao vivo, QR Code e histórico local. 100% offline na sua máquina.',
      },
      {
        href: '/ferramentas/gerador-qr-code-pix',
        title: 'Gerador de QR Code Pix',
        desc: 'Gere QR Code Pix (BR Code) 100% local, sem enviar sua chave a servidores.',
      },
    ],
  },
];

const totalTools = categories.reduce((acc, cat) => acc + cat.items.length, 0);

const title = 'Ferramentas Grátis Online | 22 Utilitários 100% Locais e Privados | CofreUtil';
const description =
  'Catálogo com 22 ferramentas online gratuitas que rodam 100% no seu navegador: conversor de imagens, juntar e dividir PDF, OCR, gerador de QR Code Pix, remover silêncio de vídeo e áudio, formatação JSON, conversor de áudio e mais. Zero upload, zero cadastro e conformidade LGPD.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ferramentas Online Grátis e Privadas',
  description,
  url: 'https://cofreutil.com.br/ferramentas',
  numberOfItems: totalTools,
  itemListElement: categories.flatMap((cat, catIndex) =>
    cat.items.map((item, itemIndex) => ({
      '@type': 'ListItem',
      position: catIndex * 1000 + itemIndex + 1,
      name: item.title,
      url: `https://cofreutil.com.br${item.href}`,
    })),
  ),
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-6 pb-24 pt-28 md:pt-36">
    <header class="border-b border-[#27272A] pb-10">
      <span class="font-mono text-xs text-[#52525B]">// CATÁLOGO COMPLETO</span>
      <h1 class="mt-4 font-mono text-3xl font-bold leading-tight tracking-tight md:text-5xl">
        Ferramentas <span class="text-[#A1A1AA]">CofreUtil</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-[#A1A1AA] md:text-lg">
        {description}
      </p>
      <p class="mt-4 font-mono text-xs text-[#52525B]">
        // {totalTools} UTILITÁRIOS • 100% NO NAVEGADOR • ZERO UPLOAD • ZERO CADASTRO
      </p>
    </header>

    <nav
      aria-label="Acesso rápido por categoria"
      class="mt-10 flex flex-wrap items-center gap-3"
    >
      <span class="font-mono text-[10px] tracking-widest text-[#52525B]">// ACESSO RÁPIDO</span>
      {categories.map((cat) => (
        <a
          href={`#${cat.id}`}
          class="border border-[#27272A] bg-[#09090B] px-4 py-2 font-mono text-xs text-[#A1A1AA] transition-colors hover:border-[#3F3F46] hover:bg-[#18181B] hover:text-white"
        >
          {cat.label} <span class="text-[#52525B]">({cat.items.length})</span>
        </a>
      ))}
    </nav>

    {categories.map((cat) => (
      <section id={cat.id} class="mt-16 scroll-mt-24">
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <h2 class="font-mono text-xl font-bold text-white">{cat.label}</h2>
          <span class="border border-[#27272A] bg-[#09090B] px-2 py-0.5 font-mono text-[10px] text-[#52525B]">
            {cat.items.length} ITENS
          </span>
        </div>
        <p class="-mt-3 mb-6 max-w-2xl text-sm leading-relaxed text-[#A1A1AA]">{cat.tagline}</p>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cat.items.map((item) => (
            <a
              href={item.href}
              class="group flex flex-col gap-3 border border-[#27272A] rounded-none bg-[#09090B] p-6 transition-colors hover:border-[#3F3F46] hover:bg-[#18181B]"
            >
              <span class="self-start border border-[#27272A] bg-black px-2 py-0.5 font-mono text-xs text-[#A1A1AA]">
                {cat.label}
              </span>
              <h3 class="font-mono text-sm font-medium leading-snug text-white">{item.title}</h3>
              <p class="text-xs leading-relaxed text-[#A1A1AA]">{item.desc}</p>
              <span class="mt-auto font-mono text-xs text-[#52525B] group-hover:text-[#A1A1AA]">
                {item.href} →
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>
</Layout>