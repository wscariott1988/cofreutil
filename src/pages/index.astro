    category: "utilitarios",
    iconKey: "chat"
  },
  {
    title: "Formatador e Validador JSON",
    description: "Formate, idente e valide payloads JSON localmente sem trafegar dados sensíveis em APIs.",
    href: "/ferramentas/formatador-json",
