  shield: `<svg class="w-6 h-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12z" /></svg>`,
  code: `<svg class="w-6 h-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>`,
  hash: `<svg class="w-6 h-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 8.25h15m-16.5 7.5h15m-1.8-13.5-3.9 19.5m-2.1-19.5-3.9 19.5" /></svg>`,
  chat: `<svg class="w-6 h-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.598.598 0 0 1-.655-.705l.437-2.337A10.026 10.026 0 0 1 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>`
};

const tools = [
  // --- SEÇÃO MÍDIA, DOCUMENTOS & OCR (10 ferramentas) ---
  {
    title: "Juntar PDF",
    description: "Junte contratos e documentos sensíveis diretamente na memória do seu navegador sem upload.",
    href: "/ferramentas/juntar-pdf",
    category: "midia",
    iconKey: "pdf"
  },
  {
    title: "Comprimir PDF",
    description: "Reduza o tamanho de PDFs pesados mantendo a qualidade visual e o sigilo total dos dados.",
    href: "/ferramentas/comprimir-pdf",
    category: "midia",
    iconKey: "compress"
  },
  {
    title: "Dividir PDF",
    description: "Separe páginas específicas ou divida documentos longos de forma instantânea e 100% local.",
    href: "/ferramentas/dividir-pdf",
    category: "midia",
    iconKey: "split"
  },
  {
    title: "Mesclar Documentos PDF",
    description: "Unifique múltiplos relatórios, PDFs e folhas avulsas em uma única sequência organizada.",
    href: "/ferramentas/pdf-merge",
    category: "midia",
    iconKey: "pdf"
  },
  {
    title: "Sanitizar PDF",
    description: "Remova scripts, metadados ocilantes, anexos e elementos de rastreamento de arquivos PDF.",
    href: "/ferramentas/pdf-sanitizer",
    category: "midia",
    iconKey: "shield"
  },
  {
    title: "Imagem para PDF",
    description: "Converta fotos, escaneamentos e prints (JPG, PNG, WEBP) em um arquivo PDF estruturado.",
    href: "/ferramentas/image-to-pdf",
    category: "midia",
    iconKey: "image"
  },
  {
    title: "Imagem para Texto (OCR)",
    description: "Extraia textos editáveis de fotos e prints usando IA local (Tesseract WASM no processador).",
    href: "/ferramentas/imagem-para-texto",
    category: "midia",
    iconKey: "ocr"
  },
  {
    title: "Conversor de Imagem",
    description: "Altere o formato de suas imagens para WEBP, PNG ou JPG via Canvas API local.",
    href: "/ferramentas/converter-imagem",
    category: "midia",
    iconKey: "image"
  },
  {
    title: "Conversor de Áudio",
    description: "Converta arquivos de som (WAV, MP3, OGG) diretamente pelo navegador usando FFmpeg WASM.",
    href: "/ferramentas/converter-audio",
    category: "midia",
    iconKey: "audio"
  },
  {
    title: "Removedor de Silêncio em Áudio",
    description: "Corte automaticamente pausas e trechos silenciosos de gravações e podcasts.",
    href: "/ferramentas/silence-remover",
    category: "midia",
    iconKey: "audio"
  },
  {
    title: "Leitor de Passaporte (MRZ)",
    description: "Extraia e decodifique dados da Zona Legível por Máquina (MRZ) de passaportes e RGs.",
    href: "/ferramentas/mrz-reader",
    category: "midia",
    iconKey: "idcard"
  },

  // --- SEÇÃO SEGURANÇA & PRIVACIDADE (4 ferramentas) ---
  {
    title: "Gerador de Senhas Fortes",
    description: "Gere senhas criptográficas ultra-seguras usando a Web Crypto API nativa do seu navegador.",
    href: "/ferramentas/gerador-senhas",
    category: "seguranca",
    iconKey: "key"
  },
  {
    title: "Limpador de Metadados EXIF",
    description: "Remova coordenadas GPS, modelo de câmera e dados pessoais de fotos antes de compartilhar.",
    href: "/ferramentas/limpar-metadados-exif",
    category: "seguranca",
    iconKey: "shield"
  },
  {
    title: "Calculadora de Hash",
    description: "Calcule hashes SHA-256, SHA-1 e MD5 de arquivos localmente para checagem de integridade.",
