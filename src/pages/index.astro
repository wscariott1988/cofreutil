  // --- SEÇÃO DEV, PIX & UTILIDADES (9 ferramentas) ---
  {
    title: "Gerador de CPF / Validador de CNPJ",
    description: "Gere e valide CPFs e CNPJs válidos matematicamente para testes de desenvolvimento e QA.",
    href: "/ferramentas/gerador-de-cpf",
    category: "utilitarios",
    iconKey: "idcard"
  },
  {
    title: "Validador de CNPJ",
    description: "Confira a estrutura matemática e os dígitos verificadores de CNPJs de forma rápida e offline.",
    href: "/ferramentas/validador-cnpj",
    category: "utilitarios",
