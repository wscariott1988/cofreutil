    category: "utilitarios",
    iconKey: "code"
  },
  {
    title: "Contador de Caracteres & Palavras",
    description: "Analise métricas de texto, total de palavras, caracteres, linhas e estimativa de leitura.",
    href: "/ferramentas/char-counter",
    category: "utilitarios",
    iconKey: "hash"
  },
  {
    title: "Gerador Pix Cópiar e Cola",
    description: "Gere chaves e payloads Pix prontos para cópia rápida em transações do dia a dia.",
