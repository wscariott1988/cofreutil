---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-center justify-center border-b border-[#27272A] bg-black overflow-hidden py-24 md:py-32">
    <!-- Efeito Canvas 2D de Partículas (Estilo Trae / Terminal Criptográfico) -->
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0 opacity-40" aria-hidden="true"></canvas>

    <div class="relative z-10 mx-auto max-w-6xl px-6 w-full flex flex-col gap-8 text-left">
      <div class="flex flex-col gap-6">
        <h1 class="font-mono text-4xl font-bold leading-tight tracking-tight md:text-6xl text-white">
          Processamento local.<br>
          <span class="text-[#A1A1AA]">Privacidade de cofre.</span>
        </h1>
        
        <p class="max-w-2xl text-base leading-relaxed text-[#A1A1AA] md:text-lg">
          O CofreUtil é seu diretório de 23 utilitários <em class="text-white not-italic font-mono">Zero-Server</em>. Seus documentos, fotos, áudios e dados rodam 100% no seu navegador via WebAssembly e APIs locais. Zero uploads, velocidade máxima e conformidade nativa com a LGPD.
        </p>
      </div>

      <div class="mt-4 flex items-center gap-4">
        <a href="#ferramentas" class="border border-[#27272A] bg-[#09090B] px-5 py-2.5 text-sm text-white font-mono hover:border-[#3F3F46] hover:bg-[#18181B] hover:text-white transition-colors">
          Explorar 23 ferramentas &rarr;
        </a>
        <a href="#como-funciona" class="text-sm text-[#A1A1AA] font-mono hover:text-white transition-colors">
          Como funciona
        </a>
      </div>
    </div>
  </section>

  <!-- Catálogo Completo de 23 Ferramentas -->
  <section id="ferramentas" class="bg-black py-16 md:py-24 border-b border-[#27272A] scroll-mt-14">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <h2 class="font-mono text-sm text-[#A1A1AA] mb-2">// CATÁLOGO COMPLETO (23 FERRAMENTAS)</h2>
          <h3 class="font-mono text-2xl font-bold text-white">Nossos Utilitários</h3>
        </div>

        <!-- Filtros brutalistas por Categoria -->
        <div class="flex flex-wrap gap-2" role="tablist" id="filter-buttons">
          <button data-category="todos" class="filter-btn bg-white text-black border border-[#27272A] rounded-none px-4 py-1.5 text-xs font-mono transition-colors uppercase">
            Todos (23)
          </button>
          <button data-category="midia" class="filter-btn bg-transparent text-[#A1A1AA] border border-[#27272A] rounded-none px-4 py-1.5 text-xs font-mono transition-colors hover:text-white hover:border-[#3F3F46] uppercase">
            Mídia & OCR (11)
          </button>
          <button data-category="seguranca" class="filter-btn bg-transparent text-[#A1A1AA] border border-[#27272A] rounded-none px-4 py-1.5 text-xs font-mono transition-colors hover:text-white hover:border-[#3F3F46] uppercase">
            Segurança & Privacidade (3)
          </button>
          <button data-category="utilitarios" class="filter-btn bg-transparent text-[#A1A1AA] border border-[#27272A] rounded-none px-4 py-1.5 text-xs font-mono transition-colors hover:text-white hover:border-[#3F3F46] uppercase">
            Dev & Utilidades (9)
          </button>
        </div>
      </div>

      <!-- Grid de 23 Cartões Brutalistas -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="tools-grid">
        {tools.map((tool) => (
          <a href={tool.href} class="tool-card group flex flex-col gap-3 border border-[#27272A] bg-[#09090B] p-6 transition-all duration-150 hover:border-[#3F3F46] hover:bg-[#111113]" data-category={tool.category}>
            <!-- SVG Icon Holder -->
            <div class="self-start text-[#A1A1AA] group-hover:text-white transition-colors" set:html={iconMap[tool.iconKey] || iconMap['code']} />
            
            <h3 class="font-mono text-sm font-semibold text-white tracking-tight mt-2">{tool.title}</h3>
            <p class="text-xs leading-relaxed text-[#A1A1AA]">{tool.description}</p>
            
            <span class="mt-auto font-mono text-xs text-[#52525B] group-hover:text-[#A1A1AA] transition-colors pt-4 flex items-center gap-1">
              {tool.href} <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Seção Arquitetura & LGPD -->
  <section id="como-funciona" class="bg-black py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-mono text-sm text-[#A1A1AA] mb-4">// ARQUITETURA LOCAL E PRIVACIDADE</h2>
      <div class="grid md:grid-cols-2 gap-12">
        <div class="flex flex-col gap-6">
          <h3 class="text-2xl font-bold text-white leading-snug">
            Por que processar dados localmente protege você?
          </h3>
          <p class="text-sm leading-relaxed text-[#A1A1AA]">
            A maioria dos sites de utilitários na nuvem exige que você faça o upload dos seus arquivos (documentos fiscais, PDFs de contratos, áudios com segredos comerciais) para servidores remotos. Isso viola as regras estritas da LGPD e introduz grandes vulnerabilidades de vazamento de dados.
          </p>
          <p class="text-sm leading-relaxed text-[#A1A1AA]">
            No <strong>CofreUtil</strong>, implementamos uma arquitetura de <strong>Privacidade por Design (Privacy-by-Architecture)</strong>. Usamos Web Crypto, Canvas API e binários compilados em <strong>WebAssembly (WASM)</strong> rodando no seu hardware. Nada é enviado para o nosso backend, garantindo sigilo total, rapidez extrema e conformidade automática.
          </p>
        </div>

        <div class="border border-[#27272A] p-8 flex flex-col justify-center gap-6 bg-[#09090B]">
          <h4 class="font-mono text-xs text-white uppercase tracking-wider">// Garantias de Segurança</h4>
          <ul class="font-mono text-xs text-[#A1A1AA] flex flex-col gap-4">
            <li class="flex items-start gap-2">
              <span class="text-white">[✓]</span> 23 Ferramentas 100% Client-Side (Zero upload)
            </li>
            <li class="flex items-start gap-2">
              <span class="text-white">[✓]</span> Sem Cookies invasivos ou rastreadores terceiros
            </li>
            <li class="flex items-start gap-2">
              <span class="text-white">[✓]</span> Totalmente adequado à LGPD por arquitetura
            </li>
            <li class="flex items-start gap-2">
              <span class="text-white">[✓]</span> Funcionamento offline e velocidade máxima
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Script de Filtro e Partículas -->
  <script is:inline>
    // 1. Script para Filtros de Categorias
    const buttons = document.querySelectorAll('#filter-buttons .filter-btn');
    const cards = document.querySelectorAll('#tools-grid .tool-card');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('bg-white', 'text-black');
          b.classList.add('bg-transparent', 'text-[#A1A1AA]');
        });

        btn.classList.remove('bg-transparent', 'text-[#A1A1AA]');
        btn.classList.add('bg-white', 'text-black');

        const category = btn.getAttribute('data-category');

        cards.forEach(card => {
          if (category === 'todos' || card.getAttribute('data-category') === category) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // 2. Script para Partículas no Canvas 2D
    const canvas = document.getElementById('hero-canvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      let particles = [];
      let animationId = null;
      let width = 0;
      let height = 0;

      const PARTICLE_SIZE = 3;
      const GRID_SPACING = 30;
      const DRIFT_AMPLITUDE = 15;

      const resize = () => {
        width = canvas.parentElement.clientWidth;
        height = canvas.parentElement.clientHeight;
        canvas.width = width * pixelRatio;
        canvas.height = height * pixelRatio;
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        ctx.scale(pixelRatio, pixelRatio);
        init();
      };

      const init = () => {
        particles = [];
        const cols = Math.floor(width / GRID_SPACING);
        const rows = Math.floor(height / GRID_SPACING);

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const x = c * GRID_SPACING + (GRID_SPACING / 2);
            const y = r * GRID_SPACING + (GRID_SPACING / 2);

            const distFromCenter = Math.hypot(x - width / 2, y - height / 2);
            const isCenterArea = distFromCenter < Math.min(width, height) * 0.35;
            
            if (isCenterArea && Math.random() > 0.2) continue;

            particles.push({
              ox: x,
              oy: y,
              x: x,
              y: y,
              phase: Math.random() * Math.PI * 2,
              speed: 0.5 + Math.random() * 0.5,
              opacity: 0.1 + Math.random() * 0.25
            });
          }
        }
      };

      const animate = (timestamp) => {
        ctx.clearRect(0, 0, width, height);

        particles.forEach(p => {
          const elapsed = timestamp * 0.001 * p.speed;
          const driftX = Math.sin(elapsed + p.phase) * DRIFT_AMPLITUDE;
          const driftY = Math.cos(elapsed * 0.7 + p.phase) * DRIFT_AMPLITUDE;

          p.x = p.ox + driftX;
          p.y = p.oy + driftY;

          ctx.fillStyle = `rgba(39, 39, 42, ${p.opacity})`;
          ctx.fillRect(p.x, p.y, PARTICLE_SIZE, PARTICLE_SIZE);
        });

        animationId = requestAnimationFrame(animate);
      };

      window.addEventListener('resize', resize);
      resize();

      if (!reducedMotion) {
        animationId = requestAnimationFrame(animate);
      } else {
        animate(0);
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          if (animationId) cancelAnimationFrame(animationId);
        } else {
          if (!reducedMotion) animationId = requestAnimationFrame(animate);
        }
      });
    }
  </script>
</Layout>
