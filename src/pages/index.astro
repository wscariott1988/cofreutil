---
import Layout from '../layouts/Layout.astro';

const title = "CofreUtil | Ferramentas Web Locais e Seguras (Zero Nuvem)";
const description = "Utilitários de alta performance que rodam 100% no seu navegador. Comprima PDFs, converta arquivos, gere dados e analise textos sem enviar nada para servidores. Privacidade absoluta.";

// Mapa de ícones em SVG inline puros (100% livre de CDNs ou dependências para COOP/COEP)
