  pix: `<svg class="w-6 h-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5zM20.25 14.625v.008H20.26v-.008h-.008zm0 2.25v.008H20.26V16.87h-.008zm-2.25-2.25v.008h.008v-.008h-.008zm0 2.25v.008h.008V16.87h-.008zm-2.25-2.25v.008h.008v-.008h-.008zm0 2.25v.008h.008V16.87h-.008zm-2.25-2.25v.008h.008v-.008h-.008zm0 2.25v.008h.008V16.87h-.008zm4.5 4.5v.008h.008V21.37h-.008zm-2.25 0v.008h.008V21.37h-.008zm-2.25 0v.008h.008V21.37h-.008zm-2.25 0v.008h.008V21.37h-.008z" /></svg>`,
