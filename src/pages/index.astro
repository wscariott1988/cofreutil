---
import Layout from '../layouts/Layout.astro';

const title = "CofreUtil | 23 Ferramentas Web Locais e Seguras (Zero Nuvem)";
const description = "Utilitários de alta performance que rodam 100% no seu navegador. Comprima PDFs, converta arquivos, gere dados e analise textos sem enviar nada para servidores. Privacidade absoluta.";

// Mapa de ícones em SVG inline puros (100% livre de CDNs ou dependências para COOP/COEP)
const iconMap = {
  pdf: `<svg class="w-6 h-6 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>`,
