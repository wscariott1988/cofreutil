{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/ferramentas/gerador-de-senhas-fortes",
      "destination": "/ferramentas/gerador-senhas",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "(?!(cofreutil\\.com\\.br|www\\.cofreutil\\.com\\.br)$).*"
        }
      ]
    }
  ]
}
